#!/usr/bin/env python3
"""Seed the shared-workspace backlog onto a tsk board. Safe to re-run.

usage: scripts/sync-seed-tasks [backlog.json]
Uses `tsk` on PATH (override with TSK_BIN). Tasks go in this repo's project scope.
Existing tasks are not edited. Missing steps or prerequisites are reported.
"""
import json
import os
import subprocess
import sys
from pathlib import Path

repo = Path(__file__).resolve().parent.parent
backlog = Path(sys.argv[1]) if len(sys.argv) > 1 else repo / "docs/sync/backlog.json"
tsk = os.environ.get("TSK_BIN", "tsk")


def run(*args):
    return subprocess.run([tsk, *args], check=True, capture_output=True, text=True).stdout


def task_index(*flags):
    index = {}
    for flag in flags:
        args = [flag] if flag else []
        for row in json.loads(run("list", "-p", str(repo), "--json", *args)):
            key = (row["thread"], row["title"])
            index.setdefault(key, set()).add(row["number"])
    return index


active = task_index(None, "--done")
archived = task_index("--archived")
numbers = {}
for item in json.loads(backlog.read_text()):
    key = (item["thread"], item["title"])
    matches = active.get(key) or archived.get(key) or set()
    if len(matches) > 1:
        choices = ", ".join(f"T{n}" for n in sorted(matches))
        sys.exit(f"Multiple matches for {item['title']!r}: {choices}. Resolve them, then rerun.")
    if matches:
        n, = matches
        outcome = "existing"
    else:
        args = ["add", "--json", "-p", str(repo), "-t", item["title"], "--thread", item["thread"]]
        if item.get("notes"):
            args += ["-n", item["notes"]]
        result = json.loads(run(*args))
        n, outcome = result["number"], result["outcome"]
        active[key] = {n}
    numbers[item["key"]] = n
    task = f"T{n}"
    steps = item.get("steps", [])
    after = [numbers[key] for key in item.get("after", [])]
    if outcome == "created":
        for step in steps:
            run("steps", task, "add", "--", step)
        if after:
            run("edit", task, *[arg for dep in after for arg in ("--after", f"T{dep}")])
    else:
        current, = json.loads(run("list", task, "--json"))
        missing_steps = set(steps) - {step["text"] for step in current["steps"]}
        missing_after = set(after) - {dep["task"] for dep in current["after"]}
        if missing_steps or missing_after:
            gaps = [f"step {step!r}" for step in sorted(missing_steps)]
            gaps.extend(f"prerequisite T{dep}" for dep in sorted(missing_after))
            sys.exit(f"{task} is missing {', '.join(gaps)}. Update it on the board, then rerun.")
    print(f"{task} {outcome}: {item['title']}")
